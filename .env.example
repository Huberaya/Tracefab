# Neon / Prisma — server only
DATABASE_URL=postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Clerk — keep the secret server-side; the publishable key may be exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Set by the trusted API for transaction-scoped RLS context.
# Never accept this value directly from a browser request.
TRACEFAB_USER_CONTEXT=server_transaction_local
