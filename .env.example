# Neon / Prisma — server only
DATABASE_URL=postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Clerk — keep the secret server-side; the publishable key may be exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Transactional invitation email — server only.
# When these are absent, the invitation API stays in manual-delivery mode and
# returns the one-time token to the trusted caller without persisting it.
RESEND_API_KEY=re_test_replace_me
EMAIL_FROM=Tracefab <no-reply@example.com>
TRACEFAB_APP_URL=https://app.example.com

# Set by the trusted API for transaction-scoped RLS context.
# Never accept this value directly from a browser request.
TRACEFAB_USER_CONTEXT=server_transaction_local
