{
  "key": "material-data-core",
  "version": "1.0",
  "subjectTypes": ["material"],
  "title": "Material data core",
  "description": "Versioned material composition and origin facts.",
  "fields": [
    { "fieldKey": "material_name", "label": "Material name", "dataType": "text", "required": true, "evidenceRequired": false, "validationRules": { "minLength": 2, "maxLength": 240 } },
