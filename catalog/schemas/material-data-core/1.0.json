    { "fieldKey": "origin_country_code", "label": "Origin country", "dataType": "country", "required": false, "evidenceRequired": true, "validationRules": {} },
    { "fieldKey": "recycled_content_percentage", "label": "Recycled content percentage", "dataType": "percentage", "required": false, "evidenceRequired": true, "validationRules": { "min": 0, "max": 100 } },
    { "fieldKey": "composition", "label": "Composition", "dataType": "json", "required": false, "evidenceRequired": true, "validationRules": { "jsonShape": "material_composition" } }
  ]
}
