  to_contact
  contacted
  replied
  meeting
  demo
  pilot
  customer
  lost
}

enum crm_priority {
  low
  medium
  high
  critical
}

enum crm_maturity {
  unknown
  low
  medium
  high
}

enum crm_contact_status {
  to_contact
  contacted
  replied
  meeting
