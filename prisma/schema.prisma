generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                                  String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId                                                         String                         @unique @map("clerk_user_id")
  email                                                               String                         @unique
  fullName                                                            String                         @map("full_name")
  createdAt                                                           DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                           DateTime                       @default(now()) @map("updated_at") @db.Timestamptz(6)
  audit_logs                                                          audit_logs[]
  brand_supplier_relationships                                        brand_supplier_relationships[]
  certifications_certifications_created_byTousers                     certifications[]               @relation("certifications_created_byTousers")
  certifications_certifications_last_verified_byTousers               certifications[]               @relation("certifications_last_verified_byTousers")
  data_points                                                         data_points[]
  data_quality_issues_data_quality_issues_acknowledged_byTousers      data_quality_issues[]          @relation("data_quality_issues_acknowledged_byTousers")
  data_quality_issues_data_quality_issues_resolved_byTousers          data_quality_issues[]          @relation("data_quality_issues_resolved_byTousers")
  data_requests_data_requests_created_byTousers                       data_requests[]                @relation("data_requests_created_byTousers")
  data_requests_data_requests_reviewed_byTousers                      data_requests[]                @relation("data_requests_reviewed_byTousers")
  data_responses_data_responses_responded_byTousers                   data_responses[]               @relation("data_responses_responded_byTousers")
  data_responses_data_responses_reviewed_byTousers                    data_responses[]               @relation("data_responses_reviewed_byTousers")
  data_shares                                                         data_shares[]
  documents_documents_deleted_byTousers                               documents[]                    @relation("documents_deleted_byTousers")
  documents_documents_uploaded_byTousers                              documents[]                    @relation("documents_uploaded_byTousers")
  dpp_records_dpp_records_computed_byTousers                          dpp_records[]                  @relation("dpp_records_computed_byTousers")
  dpp_records_dpp_records_reviewed_byTousers                          dpp_records[]                  @relation("dpp_records_reviewed_byTousers")
  materials                                                           materials[]
  orders                                                              orders[]
  organization_invitations                                            organization_invitations[]
  organization_memberships_organization_memberships_invited_byTousers organization_memberships[]     @relation("organization_memberships_invited_byTousers")
  organization_memberships_organization_memberships_user_idTousers    organization_memberships[]     @relation("organization_memberships_user_idTousers")
  organizations                                                       organizations[]
  product_identifiers                                                 product_identifiers[]
  suppliers                                                           suppliers[]
  supply_chain_links                                                  supply_chain_links[]
  supply_chain_nodes                                                  supply_chain_nodes[]
  tracefab_products_tracefab_products_created_byTousers               tracefab_products[]            @relation("tracefab_products_created_byTousers")
  tracefab_products_tracefab_products_last_data_updated_byTousers     tracefab_products[]            @relation("tracefab_products_last_data_updated_byTousers")
  verification_records                                                verification_records[]

  @@map("users")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  actor_user_id   String?       @db.Uuid
  action          String
  entity_type     String
  entity_id       String?       @db.Uuid
  before_state    Json?
  after_state     Json?
  metadata        Json          @default("{}")
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  users           User?         @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id, created_at(sort: Desc)], map: "idx_audit_org_created")
}

