  pilot
  conversion
  lost
}

model crm_companies {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_organization_id String           @db.Uuid
  platform_organization  organizations @relation("crm_companies_platform", fields: [platform_organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name                   String
  website                String?
  country_code           String?            @db.VarChar(2)
  city                   String?
  industry               String?
  company_type           crm_company_type   @default(other)
  employee_band          String?
  revenue_band           String?
  product_count          Int?
  supplier_count         Int?
  maturity               crm_maturity       @default(unknown)
  /* Intérêt DÉCLARÉ par l'équipe, jamais déduit automatiquement. */
  dpp_interest           crm_interest_level @default(unknown)
  traceability_interest  crm_interest_level @default(unknown)
  priority               crm_priority       @default(medium)
  stage                  crm_pipeline_stage @default(new)
  lost_reason            String?
  source                 String?
  /* Provenance : jamais d'entreprise inventée. Si une donnée vient d'un import
     ou d'une source externe, ces deux champs disent d'où et quand. */
  source_detail          String?
  collected_at           DateTime?          @db.Timestamptz(6)
  owner_user_id          String?            @db.Uuid
  organization_id        String?            @db.Uuid
  linked_organization    organizations @relation("crm_companies_linked", fields: [organization_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  campaign_id            String?            @db.Uuid
  owner_name             String?
  notes                  String?
  estimated_value_eur    Int?
  last_contact_at        DateTime?          @db.Timestamptz(6)
  next_contact_at        DateTime?          @db.Timestamptz(6)
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  updated_at             DateTime           @default(now()) @db.Timestamptz(6)
  crm_contacts           crm_contacts[]
  crm_activities         crm_activities[]

  crm_tasks              crm_tasks[]
  crm_meetings           crm_meetings[]
  crm_pilots             crm_pilots[]
  crm_leads              crm_leads[]
  @@unique([platform_organization_id, name], map: "crm_companies_org_name_key")
  @@index([platform_organization_id, converted_at], map: "idx_crm_companies_org_converted")
  @@index([platform_organization_id, dpp_interest], map: "idx_crm_companies_org_dpp_interest")
  @@index([platform_organization_id, traceability_interest], map: "idx_crm_companies_org_traceability_interest")
  @@index([platform_organization_id, product_count], map: "idx_crm_companies_org_product_count")
  @@index([platform_organization_id, supplier_count], map: "idx_crm_companies_org_supplier_count")
  @@index([platform_organization_id, employee_band], map: "idx_crm_companies_org_employee_band")
  @@index([platform_organization_id, stage], map: "idx_crm_companies_org_stage")
  @@index([platform_organization_id, priority], map: "idx_crm_companies_org_priority")
  @@index([platform_organization_id, country_code], map: "idx_crm_companies_org_country")
  @@index([platform_organization_id, next_contact_at], map: "idx_crm_companies_org_next_contact")
  @@index([platform_organization_id, organization_id], map: "idx_crm_companies_org_link")
  @@index([platform_organization_id, campaign_id], map: "idx_crm_companies_campaign")
}

