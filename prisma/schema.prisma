  organizations_verification_records_verifier_organization_idToorganizations organizations?      @relation("verification_records_verifier_organization_idToorganizations", fields: [verifier_organization_id], references: [id], onUpdate: NoAction)

  @@index([owner_organization_id, status], map: "idx_verifications_owner")
}

