model crm_campaigns {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_organization_id String           @db.Uuid
  organizations          organizations @relation(fields: [platform_organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name                   String
  channel                crm_campaign_channel@default(email)
  status                 crm_campaign_status@default(draft)
  objective              String?
  target_audience        String?
  starts_at              DateTime?          @db.Timestamptz(6)
  ends_at                DateTime?          @db.Timestamptz(6)
  budget_eur             Decimal?           @db.Decimal(12, 2)
  owner_name             String?
  notes                  String?
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  updated_at             DateTime           @default(now()) @db.Timestamptz(6)

  crm_leads              crm_leads[]
  @@unique([platform_organization_id, name], map: "uq_crm_campaigns_org_name")
  @@index([platform_organization_id, status], map: "idx_crm_campaigns_org_status")
}

model crm_leads {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_organization_id String           @db.Uuid
  organizations          organizations @relation(fields: [platform_organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campaign_id            String?            @db.Uuid
  crm_campaigns          crm_campaigns @relation(fields: [campaign_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  company_name           String
  contact_name           String?
  contact_job_title      String?
  email                  String?
  phone                  String?
  linkedin_url           String?
  website                String?
  country_code           String?            @db.VarChar(2)
  city                   String?
  sector                 String?
  status                 crm_lead_status    @default(new)
  discard_reason         String?
  converted_company_id   String?            @db.Uuid
  converted_company      crm_companies @relation(fields: [converted_company_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  converted_at           DateTime?          @db.Timestamptz(6)
  duplicate_key          String
  source                 String?
  source_detail          String?
  collected_at           DateTime?          @db.Timestamptz(6)
  notes                  String?
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  updated_at             DateTime           @default(now()) @db.Timestamptz(6)

  @@unique([platform_organization_id, duplicate_key], map: "uq_crm_leads_org_duplicate")
  @@index([platform_organization_id, status], map: "idx_crm_leads_org_status")
  @@index([platform_organization_id, campaign_id], map: "idx_crm_leads_org_campaign")
  @@index([converted_company_id], map: "idx_crm_leads_converted")
}
