/* ========================================================================== *
 * Chantier Admin 03 — acquisition : listes de prospection (§7),
 * import CSV (§8), recherche avancée (§9).
 *
 * Une liste de prospection n'est qu'un jeu de filtres nommé. Elle vit en base
 * plutôt qu'en localStorage pour qu'une équipe la partage : « France – Marques
 * de mode » doit exister pour le fondateur comme pour le commercial.
 *
 * `collected_at` et `source_detail` existent depuis le Chantier 01 : la règle
 * « jamais d'entreprise inventée, toute donnée externe garde sa source et sa
 * date » est déjà modélisée, l'import ne fait que l'alimenter.
 * ========================================================================== */

/*
 * `unknown` est explicite : il signifie « non qualifié », pas « faible ».
 * Confondre les deux ferait trier l'équipe sur une absence de donnée.
 */
enum crm_interest_level {
