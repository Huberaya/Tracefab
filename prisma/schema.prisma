/* -------------------------------------------------------------------------- *
 * TRACEFAB COMMAND CENTER — CRM de prospection (Chantier Admin 01)
 *
 * Ces tables appartiennent à TRACEFAB, pas à un client. Chaque ligne porte
 * `platform_organization_id`, qui pointe vers une organisation de type
 * `platform` : c'est l'ancre de la RLS. Aucune marque ni aucun fournisseur ne
 * peut lire ces données, parce qu'aucune politique ne le leur accorde.
 * -------------------------------------------------------------------------- */

enum crm_company_type {
  fashion_brand
  textile_brand
  manufacturer
  textile_supplier
  mill
  dye_house
  garment_factory
  luxury_brand
  sportswear
  outdoor
  retailer
  marketplace
  other
}

